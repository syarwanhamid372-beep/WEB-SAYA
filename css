/* ================================================================
   STYLE.CSS — Portfolio Pribadi
   Struktur:
   1. Variabel & Tema
   2. Reset & Base
   3. Utility (container, btn, section)
   4. Loader
   5. Navbar
   6. Hero
   7. Tentang
   8. CV
   9. Portfolio
   10. Galeri
   11. Media Sosial
   12. Testimoni
   13. Kontak
   14. Footer
   15. Back to top
   16. Lightbox & Modal
   17. Animasi Scroll
   18. Responsive
   ================================================================ */

/* ================================================================
   1. VARIABEL & TEMA
   ================================================================ */
:root {
  /* Warna Mode Terang */
  --bg: #f8fafc;
  --bg-alt: #ffffff;
  --card: #ffffff;
  --text: #1e293b;
  --text-muted: #64748b;
  --border: #e2e8f0;
  --primary: #4f46e5;
  --primary-hover: #4338ca;
  --primary-soft: rgba(79, 70, 229, 0.1);
  --shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.06);
  --shadow: 0 6px 24px rgba(15, 23, 42, 0.08);
  --shadow-lg: 0 16px 40px rgba(15, 23, 42, 0.12);
  --radius: 16px;
  --radius-sm: 10px;
  --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Warna Mode Gelap */
[data-theme="dark"] {
  --bg: #0f172a;
  --bg-alt: #131f38;
  --card: #1e293b;
  --text: #e2e8f0;
  --text-muted: #94a3b8;
  --border: #334155;
  --primary: #818cf8;
  --primary-hover: #a5b4fc;
  --primary-soft: rgba(129, 140, 248, 0.14);
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
  --shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.45);
}

/* ================================================================
   2. RESET & BASE
   ================================================================ */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Poppins", system-ui, -apple-system, sans-serif;
  background-color: var(--bg);
  color: var(--text);
  line-height: 1.7;
  overflow-x: hidden;
  transition: background-color var(--transition), color var(--transition);
}

img {
  max-width: 100%;
  display: block;
}

a {
  text-decoration: none;
  color: inherit;
}

ul {
  list-style: none;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

/* Offset agar judul section tidak tertutup navbar */
section[id] {
  scroll-margin-top: 80px;
}

/* ================================================================
   3. UTILITY
   ================================================================ */
.container {
  width: 100%;
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 24px;
}

.section {
  padding: 100px 0;
  position: relative;
}

.section-alt {
  background-color: var(--bg-alt);
  transition: background-color var(--transition);
}

.section-head {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 60px;
}

.section-tag {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 6px 16px;
  border-radius: 999px;
  margin-bottom: 16px;
}

.section-title {
  font-size: clamp(1.7rem, 4vw, 2.4rem);
  font-weight: 700;
  line-height: 1.25;
  margin-bottom: 12px;
}

.section-sub {
  color: var(--text-muted);
  font-size: 0.98rem;
}

/* --- Tombol --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 13px 26px;
  border-radius: 999px;
  font-size: 0.93rem;
  font-weight: 600;
  transition: transform var(--transition), box-shadow var(--transition),
    background-color var(--transition), color var(--transition);
  white-space: nowrap;
}

.btn:hover {
  transform: translateY(-3px);
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 8px 20px rgba(79, 70, 229, 0.3);
}
[data-theme="dark"] .btn-primary {
  color: #0f172a;
}
.btn-primary:hover {
  background: var(--primary-hover);
  box-shadow: 0 12px 26px rgba(79, 70, 229, 0.42);
}

.btn-outline {
  border: 2px solid var(--border);
  color: var(--text);
  background: transparent;
}
.btn-outline:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: var(--primary-soft);
}

.btn-wa {
  background: #25d366;
  color: #fff;
  box-shadow: 0 8px 20px rgba(37, 211, 102, 0.3);
}
.btn-wa:hover {
  background: #1ebe5b;
}

.btn-sm {
  padding: 9px 16px;
  font-size: 0.82rem;
}

.btn-block {
  width: 100%;
}

/* ================================================================
   4. LOADER
   ================================================================ */
.loader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--bg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  transition: opacity 0.5s ease, visibility 0.5s ease;
}

.loader.hide {
  opacity: 0;
  visibility: hidden;
}

.loader-spinner {
  width: 52px;
  height: 52px;
  border: 4px solid var(--border);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loader-text {
  font-size: 0.85rem;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

/* ================================================================
   5. NAVBAR
   ================================================================ */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background: transparent;
  transition: background-color var(--transition), box-shadow var(--transition),
    backdrop-filter var(--transition);
}

.navbar.scrolled {
  background: color-mix(in srgb, var(--bg) 85%, transparent);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  box-shadow: var(--shadow-sm);
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 700;
  font-size: 1.02rem;
}

.logo-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: var(--primary);
  color: #fff;
  font-size: 0.85rem;
  font-weight: 700;
}
[data-theme="dark"] .logo-mark {
  color: #0f172a;
}

.logo-text {
  display: inline-block;
}

.nav-list {
  display: flex;
  align-items: center;
  gap: 4px;
}

.nav-link {
  position: relative;
  display: block;
  padding: 8px 13px;
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--text-muted);
  border-radius: 8px;
  transition: color var(--transition), background-color var(--transition);
}

.nav-link:hover {
  color: var(--primary);
  background: var(--primary-soft);
}

.nav-link.active {
  color: var(--primary);
  font-weight: 600;
}

.nav-link.active::after {
  content: "";
  position: absolute;
  bottom: 2px;
  left: 50%;
  transform: translateX(-50%);
  width: 16px;
  height: 2px;
  border-radius: 2px;
  background: var(--primary);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.theme-toggle {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 0.95rem;
  transition: transform var(--transition), background-color var(--transition);
}

.theme-toggle:hover {
  transform: rotate(20deg) scale(1.08);
}

.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background: var(--primary-soft);
}

.hamburger span {
  width: 20px;
  height: 2px;
  background: var(--primary);
  border-radius: 2px;
  transition: transform var(--transition), opacity var(--transition);
}

.hamburger.active span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}
.hamburger.active span:nth-child(2) {
  opacity: 0;
}
.hamburger.active span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* ================================================================
   6. HERO
   ================================================================ */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding-top: 100px;
  padding-bottom: 60px;
  overflow: hidden;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 60px;
  align-items: center;
}

.hero-greeting {
  display: inline-block;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 8px 18px;
  border-radius: 999px;
  margin-bottom: 18px;
}

.hero-name {
  font-size: clamp(2.1rem, 6vw, 3.4rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: 10px;
  background: linear-gradient(135deg, var(--text), var(--primary));
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-typing {
  font-size: clamp(1.05rem, 3vw, 1.5rem);
  font-weight: 500;
  color: var(--text-muted);
  min-height: 2.2em;
  margin-bottom: 18px;
}

.typing-text {
  color: var(--primary);
  font-weight: 600;
  font-family: "Fira Code", monospace;
}

.cursor {
  display: inline-block;
  color: var(--primary);
  font-weight: 300;
  animation: blink 1s step-end infinite;
  margin-left: 2px;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.hero-desc {
  color: var(--text-muted);
  font-size: 1rem;
  max-width: 520px;
  margin-bottom: 30px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 34px;
}

.hero-socials {
  display: flex;
  gap: 12px;
}

.hero-socials a {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: var(--card);
  color: var(--text-muted);
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition), color var(--transition),
    background-color var(--transition), border-color var(--transition);
}

.hero-socials a:hover {
  transform: translateY(-4px);
  color: #fff;
  background: var(--primary);
  border-color: var(--primary);
}

/* --- Foto hero --- */
.hero-image {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-frame {
  position: relative;
  width: 100%;
  max-width: 360px;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  overflow: hidden;
  border: 6px solid var(--card);
  box-shadow: var(--shadow-lg);
  z-index: 2;
  animation: float 5s ease-in-out infinite;
}

.image-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14px); }
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.5;
  z-index: 1;
}

.blob-1 {
  width: 240px;
  height: 240px;
  background: var(--primary);
  top: -20px;
  right: -10px;
  animation: pulse 6s ease-in-out infinite;
}

.blob-2 {
  width: 200px;
  height: 200px;
  background: #06b6d4;
  bottom: -20px;
  left: -10px;
  animation: pulse 6s ease-in-out infinite reverse;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.15); opacity: 0.6; }
}

.scroll-down {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--card);
  color: var(--primary);
  box-shadow: var(--shadow);
  animation: bounce 2s infinite;
  transition: background-color var(--transition);
}

@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(8px); }
}

/* ================================================================
   7. TENTANG
   ================================================================ */
.about-grid {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: 60px;
  align-items: start;
}

.about-photo {
  position: relative;
  position: sticky;
  top: 100px;
}

.about-photo img {
  width: 100%;
  border-radius: var(--radius);
  box-shadow: var(--shadow-lg);
  aspect-ratio: 4 / 5;
  object-fit: cover;
}

.about-badge {
  position: absolute;
  bottom: -18px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 22px;
  border-radius: 999px;
  background: var(--card);
  color: var(--primary);
  font-weight: 600;
  font-size: 0.85rem;
  box-shadow: var(--shadow);
  white-space: nowrap;
}

.about-heading {
  font-size: 1.15rem;
  font-weight: 600;
  margin: 28px 0 14px;
  padding-left: 14px;
  border-left: 4px solid var(--primary);
  line-height: 1.2;
}

.about-heading:first-child {
  margin-top: 0;
}

.about-content p {
  color: var(--text-muted);
  font-size: 0.95rem;
}

.biodata {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.biodata li {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  transition: transform var(--transition), box-shadow var(--transition);
}

.biodata li:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-sm);
}

.biodata li span {
  display: block;
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 2px;
}

.biodata li strong {
  font-size: 0.9rem;
  font-weight: 600;
}

/* --- Chips --- */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  border-radius: 999px;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 0.83rem;
  font-weight: 500;
  transition: transform var(--transition), background-color var(--transition);
}

.chip:hover {
  transform: translateY(-3px);
  background: var(--primary);
  color: #fff;
}
[data-theme="dark"] .chip:hover {
  color: #0f172a;
}

/* --- Skill bar --- */
.skills {
  display: grid;
  gap: 16px;
}

.skill-top {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  font-weight: 500;
  margin-bottom: 7px;
}

.skill-top span:last-child {
  color: var(--primary);
  font-weight: 600;
}

.bar {
  height: 8px;
  border-radius: 99px;
  background: var(--border);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  width: 0;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--primary), #06b6d4);
  transition: width 1.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.skill.in-view .bar-fill {
  width: var(--w);
}

/* --- Mini card --- */
.two-col {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 8px;
}

.mini-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 20px;
  transition: transform var(--transition), box-shadow var(--transition),
    border-color var(--transition);
}

.mini-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow);
  border-color: var(--primary);
}

.mini-card i {
  font-size: 1.3rem;
  color: var(--primary);
  margin-bottom: 10px;
}

.mini-card h4 {
  font-size: 0.95rem;
  margin-bottom: 6px;
}

.mini-card p {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.mini-card .muted {
  font-size: 0.78rem;
  opacity: 0.8;
  margin-top: 4px;
}

/* ================================================================
   8. CV
   ================================================================ */
.cv-header {
  display: flex;
  align-items: center;
  gap: 26px;
  flex-wrap: wrap;
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px;
  box-shadow: var(--shadow-sm);
  margin-bottom: 30px;
}

.cv-photo {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--primary-soft);
}

.cv-identity {
  flex: 1;
  min-width: 220px;
}

.cv-identity h3 {
  font-size: 1.35rem;
  font-weight: 700;
}

.cv-role {
  color: var(--primary);
  font-size: 0.9rem;
  font-weight: 500;
  margin-bottom: 10px;
}

.cv-contact {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 20px;
  font-size: 0.83rem;
  color: var(--text-muted);
}

.cv-contact i {
  color: var(--primary);
  margin-right: 5px;
}

.cv-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 24px;
  align-items: start;
}

.cv-side,
.cv-main {
  display: grid;
  gap: 24px;
}

.cv-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 26px;
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition), box-shadow var(--transition);
}

.cv-card:hover {
  box-shadow: var(--shadow);
}

.cv-card h4 {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 18px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
}

.cv-card h4 i {
  color: var(--primary);
}

.cv-list {
  display: grid;
  gap: 11px;
}

.cv-list li {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 0.85rem;
}

.cv-list li span {
  color: var(--text-muted);
}

.cv-list li strong {
  font-weight: 600;
  text-align: right;
}

.cv-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.cv-tags li {
  padding: 6px 14px;
  border-radius: 999px;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 0.79rem;
  font-weight: 500;
  transition: transform var(--transition);
}

.cv-tags li:hover {
  transform: translateY(-2px);
}

/* --- Timeline --- */
.timeline {
  position: relative;
  padding-left: 28px;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 6px;
  top: 6px;
  bottom: 6px;
  width: 2px;
  background: var(--border);
}

.tl-item {
  position: relative;
  padding-bottom: 22px;
}

.tl-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  position: absolute;
  left: -28px;
  top: 6px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--primary);
  border: 3px solid var(--card);
  box-shadow: 0 0 0 2px var(--primary-soft);
}

.tl-date {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--primary);
  background: var(--primary-soft);
  padding: 3px 12px;
  border-radius: 999px;
  margin-bottom: 6px;
}

.tl-content h5 {
  font-size: 0.95rem;
  font-weight: 600;
  margin-bottom: 3px;
}

.tl-content p {
  font-size: 0.85rem;
  color: var(--text-muted);
}

/* ================================================================
   9. PORTFOLIO
   ================================================================ */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
  margin-bottom: 44px;
}

.filter-btn {
  padding: 9px 20px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-muted);
  background: var(--card);
  border: 1px solid var(--border);
  transition: all var(--transition);
}

.filter-btn:hover {
  color: var(--primary);
  border-color: var(--primary);
  transform: translateY(-2px);
}

.filter-btn.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  box-shadow: 0 6px 18px rgba(79, 70, 229, 0.3);
}
[data-theme="dark"] .filter-btn.active {
  color: #0f172a;
}

.portfolio-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 26px;
}

.portfolio-card {
  background: var(--card);
  border: 1px solid var(--border);
